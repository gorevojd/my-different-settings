{
  "$schema": "vscode://schemas/color-theme",
  "name": "Odin Grove",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "foreground": "#D2D4D2",
    "descriptionForeground": "#A0AEA0",
    "focusBorder": "#789578",
    "selection.background": "#516951",
    "textLink.foreground": "#ABC9A0",
    "textLink.activeForeground": "#D0E1CA",
    "editor.background": "#202D20",
    "editor.foreground": "#90BB90",
    "editorCursor.foreground": "#B1CBA8",
    "editorGutter.background": "#202D20",
    "editorLineNumber.foreground": "#577457",
    "editorLineNumber.activeForeground": "#7FA67F",
    "editor.lineHighlightBackground": "#383A2E",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background1": "#314231",
    "editorIndentGuide.activeBackground1": "#445A44",
    "editorWhitespace.foreground": "#3A4C3A",
    "editorRuler.foreground": "#314231",
    "editor.selectionBackground": "#405840",
    "editor.inactiveSelectionBackground": "#344934",
    "editor.selectionHighlightBackground": "#6D946D33",
    "editor.wordHighlightBackground": "#72987238",
    "editor.wordHighlightStrongBackground": "#72987250",
    "editor.findMatchBackground": "#805934",
    "editor.findMatchHighlightBackground": "#AA85553D",
    "editorBracketHighlight.foreground1": "#90BB90",
    "editorBracketHighlight.foreground2": "#90BB90",
    "editorBracketHighlight.foreground3": "#90BB90",
    "editorBracketHighlight.foreground4": "#90BB90",
    "editorBracketHighlight.foreground5": "#90BB90",
    "editorBracketHighlight.foreground6": "#90BB90",
    "editorBracketHighlight.unexpectedBracket.foreground": "#E68C79",
    "editorBracketMatch.background": "#57745740",
    "editorBracketMatch.border": "#789578",
    "editorGroupHeader.tabsBackground": "#414C41",
    "editorGroupHeader.tabsBorder": "#202D20",
    "editorGroup.border": "#414C41",
    "tab.activeBackground": "#202D20",
    "tab.activeForeground": "#FFFFFF",
    "tab.activeBorder": "#00000000",
    "tab.activeBorderTop": "#00000000",
    "tab.inactiveBackground": "#414C41",
    "tab.inactiveForeground": "#D2D4D2",
    "tab.border": "#536053",
    "tab.hoverBackground": "#374537",
    "titleBar.activeBackground": "#2B2B2B",
    "titleBar.activeForeground": "#D2D4D2",
    "titleBar.inactiveBackground": "#2B2B2B",
    "activityBar.background": "#233023",
    "activityBar.foreground": "#D2D4D2",
    "activityBar.inactiveForeground": "#829482",
    "activityBar.activeBorder": "#90BB90",
    "activityBarBadge.background": "#90BB90",
    "activityBarBadge.foreground": "#202D20",
    "sideBar.background": "#263326",
    "sideBar.foreground": "#B9C7B9",
    "sideBarSectionHeader.background": "#2C3A2C",
    "sideBar.border": "#314231",
    "statusBar.background": "#303D30",
    "statusBar.foreground": "#D2D4D2",
    "statusBar.noFolderBackground": "#303D30",
    "statusBar.debuggingBackground": "#654C3B",
    "statusBarItem.remoteBackground": "#405440",
    "list.activeSelectionBackground": "#415741",
    "list.activeSelectionForeground": "#E5ECE2",
    "list.inactiveSelectionBackground": "#354735",
    "list.hoverBackground": "#303F30",
    "list.highlightForeground": "#C9DDBD",
    "input.background": "#1D281D",
    "input.foreground": "#D2D4D2",
    "input.border": "#4A5D4A",
    "dropdown.background": "#2A382A",
    "dropdown.border": "#4A5D4A",
    "button.background": "#455E45",
    "button.foreground": "#F3F5EE",
    "button.hoverBackground": "#526F52",
    "badge.background": "#414F41",
    "badge.foreground": "#D2D4D2",
    "editorWidget.background": "#293729",
    "editorWidget.border": "#4A5D4A",
    "quickInput.background": "#293729",
    "panel.background": "#202D20",
    "panel.border": "#414C41",
    "panelTitle.activeBorder": "#90BB90",
    "terminal.background": "#202D20",
    "terminal.foreground": "#B2CAB2"
  },
  "tokenColors": [
    {
      "name": "Identifiers, calls, and numeric literals",
      "scope": ["variable", "entity.name", "support.function", "constant.numeric", "constant.other"],
      "settings": { "foreground": "#90BB90", "fontStyle": "" }
    },
    {
      "name": "Keywords, storage, and primitive types",
      "scope": ["keyword", "storage", "support.type.primitive", "support.type.builtin", "entity.name.tag", "meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#BB8060", "fontStyle": "bold" }
    },
    {
      "name": "Operators and return arrows",
      "scope": ["keyword.operator", "storage.type.function.arrow.odin"],
      "settings": { "foreground": "#90BB90", "fontStyle": "" }
    },
    {
      "name": "Strings, escapes, and language constants",
      "scope": ["string", "constant.character", "constant.language", "punctuation.definition.string"],
      "settings": { "foreground": "#6B8E24", "fontStyle": "" }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#808080", "fontStyle": "" }
    },
    {
      "name": "Odin procedure, type, and constant declarations",
      "scope": [
        "meta.definition.function.odin entity.name.function.odin",
        "meta.definition.variable.odin > entity.name.type.odin",
        "meta.definition.variable.odin > variable.other.constant.odin"
      ],
      "settings": { "foreground": "#90BB90", "fontStyle": "bold italic" }
    },
    {
      "name": "Odin attributes and directives",
      "scope": ["entity.other.attribute-name.odin", "meta.attribute.odin meta.brace.round.odin", "entity.name.tag.odin"],
      "settings": { "foreground": "#BB8060", "fontStyle": "bold" }
    }
  ]
}
